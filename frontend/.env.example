# ===========================================
# WORLDGPZ Frontend Environment Configuration
# ===========================================

# API Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=ws://localhost:5000

# Map Configuration
VITE_MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO

# Analytics (Optional)
VITE_GA_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_LIVE_UPDATES=true

# App Configuration
VITE_APP_NAME=WORLDGPZ
VITE_APP_URL=http://localhost:3000

# External APIs (Free Tier)
VITE_NEWS_API_KEY=your_newsapi_key_here
VITE_WEATHER_API_KEY=your_openweathermap_key_here