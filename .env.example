# WORLDGPZ God's Eye — safe environment template (never put real keys in Git)
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Persistence is optional for local/demo operation. Set a managed PostgreSQL URL in production.
DATABASE_URL=
DATABASE_SSL=false

# Required to enable administrator login. Generate unique random values; do not reuse exposed credentials.
ADMIN_EMAIL=
ADMIN_NAME=WORLDGPZ Administrator
ADMIN_PASSWORD=
# Prefer ADMIN_PASSWORD_HASH (bcrypt) for production instead of a plaintext env value.
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# Separate AES-256-GCM key-encryption secret; use a unique random value.
API_KEY_ENCRYPTION_SECRET=

# External providers — configure only keys you have permission to use.
NEWS_API_KEY=
OPENWEATHER_API_KEY=
FINNHUB_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BBOX=-10,-30,70,60
AISSTREAM_API_KEY=
NASA_FIRMS_API_KEY=
FIRMS_SOURCES=VIIRS_SNPP_NRT,MODIS_NRT
FIRMS_AREA=world
FIRMS_DAYS=1
EIA_API_KEY=
FRED_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CACHE_SECONDS=10800
WINDY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional behavior
PROVIDER_TIMEOUT_MS=12000
