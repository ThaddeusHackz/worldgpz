# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Required in production (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Admin console login is fixed: username `admin` / password `admin12345`.
ADMIN_NAME=GOD'S EYE Operator

# MongoDB Atlas (production). Leave blank locally to use server/data/worldgpz.json.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=worldgpz

# Durable API-key vault without a database.
# On hosts with an ephemeral filesystem (Render free tier, Fly, serverless) the
# local JSON file is wiped on every redeploy. Export the encrypted blob from
# the admin console (Secure uplink vault -> Export encrypted vault) and paste it
# here: every cold start then reseeds the same keys, on any machine.
WORLDGPZ_VAULT=
# Optional. Encryption key for the blob. Defaults to JWT_SECRET when unset, so
# a normal deployment needs no extra configuration.
WORLDGPZ_VAULT_SECRET=

# Optional data providers. Keys stay server-side and are never sent to the browser.
NEWS_API_KEY=
YOUTUBE_API_KEY=
# Live-channel discovery is cached for 3 hours to remain within YouTube search quota.
YOUTUBE_CACHE_SECONDS=10800
OPENWEATHER_API_KEY=

# Optional OpenAI-compatible intelligence provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Extended live/intelligence providers (all optional; each degrades gracefully).
# Windy Webcams API v3 — global webcam map, previews, and players.
WINDY_API_KEY=
# Finnhub — equities, indices, and crypto quotes.
FINNHUB_API_KEY=
# NASA FIRMS — satellite fire/thermal detections (free MAP key).
NASA_FIRMS_API_KEY=
# FIRMS tuning: comma-separated sources, area ("world" or "minLon,minLat,maxLon,maxLat").
FIRMS_SOURCES=VIIRS_SNPP_NRT,MODIS_NRT
FIRMS_AREA=world
FIRMS_CACHE_SECONDS=3600
# ACLED — conflict and protest events. Use a direct token OR email+password.
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
# AISStream — live ship positions (server-side WebSocket relay).
AISSTREAM_API_KEY=
# OpenSky — aircraft tracking (API client credentials; token is exchanged server-side).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OpenSky snapshot window: "minLat,minLon,maxLat,maxLon".
OPENSKY_BBOX=-10,-30,70,60
# OpenSky can be slow for continent-scale boxes; the adapter retries a regional box on timeout.
OPENSKY_TIMEOUT_MS=20000
# Cloudflare Radar — internet outages and traffic anomalies.
CLOUDFLARE_API_TOKEN=
# U.S. EIA — oil, petroleum, and natural-gas prices.
EIA_API_KEY=
# FRED — interest rates and macroeconomic indicators.
FRED_API_KEY=

# Cache/live-source tuning
SOURCE_CACHE_SECONDS=300
FETCH_TIMEOUT_MS=8000
